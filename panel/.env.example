# Pengaturan 3proxy-panel untuk Docker. Salin jadi .env lalu isi:
#   cp .env.example .env && nano .env
# Setelah mengubah .env jalankan: sudo docker compose up -d

# Password login panel (wajib). Pakai huruf dan angka.
PANEL_PASSWORD=

# Port panel. Ganti kalau 8088 sudah dipakai program lain.
PANEL_PORT=8088

# Rentang port yang boleh dipakai proxy. Port yang sudah dipakai program
# lain di VPS ditolak otomatis.
PANEL_PROXY_PORTS=20000-29999

# IP/domain yang ditampilkan di daftar proxy. Default: alamat yang dipakai
# untuk membuka panel.
#PANEL_HOST=203.0.113.10

# Panel hanya bisa dibuka dari VPS sendiri (untuk SSH tunnel). Menggantikan
# PANEL_PORT.
#PANEL_LISTEN=127.0.0.1:8088

# Pengaturan global 3proxy pengganti bawaan panel, file ada di folder data/.
#PANEL_HEADER=/data/header.cfg

# HTTPS, lihat bagian "Keamanan dan HTTPS" di README.md.
#PANEL_TLS_CERT=/etc/letsencrypt/live/panel.domainkamu.com/fullchain.pem
#PANEL_TLS_KEY=/etc/letsencrypt/live/panel.domainkamu.com/privkey.pem
